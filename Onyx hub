local function addCorner(o, r)
    local c = Instance.new("UICorner", o); c.CornerRadius = UDim.new(0, r or 8); return c
end
local function addStroke(o, color, t, tr)
    local s = Instance.new("UIStroke", o)
    s.Color = color; s.Thickness = t or 1; s.Transparency = tr or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    return s
end

