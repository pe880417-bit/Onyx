    Card.BorderSizePixel = 0
    Card.Parent = List
    addCorner(Card, 6)
    addStroke(Card, C.Border, 1)

    local Nome = Instance.new("TextLabel")
    Nome.Size = UDim2.new(0.42, 0, 1, 0)
    Nome.Position = UDim2.new(0, 12, 0, 0)
    Nome.BackgroundTransparency = 1
    Nome.Text = nome
    Nome.TextColor3 = C.Text
    Nome.Font = Enum.Font.GothamBold
    Nome.TextSize = 12
    Nome.TextXAlignment = Enum.TextXAlignment.Left
    Nome.Parent = Card

    local Star = Instance.new("TextButton")
    Star.Size = UDim2.new(0, 22, 0, 22)
    Star.Position = UDim2.new(1, -280, 0.5, -11)
    Star.BackgroundTransparency = 1
    Star.Text = "☆"
    Star.TextColor3 = C.TextDim
    Star.Font = Enum.Font.GothamBold
    Star.TextSize = 18
    Star.AutoButtonColor = false
    Star.Parent = Card

    local favAtivo = false
    Star.MouseButton1Click:Connect(function()
        favAtivo = not favAtivo
        Star.Text = favAtivo and "★" or "☆"
        Star.TextColor3 = favAtivo and C.Yellow or C.TextDim
    end)

    local badgeX = -255

    if pago then
        local rb = Instance.new("TextLabel")
        rb.Size = UDim2.new(0, 80, 0, 20)
        rb.Position = UDim2.new(1, badgeX, 0.5, -10)
        rb.BackgroundColor3 = C.Gold
        rb.Text = "💰 PAGO $12"
        rb.TextColor3 = Color3.fromRGB(30, 20, 0)
        rb.Font = Enum.Font.GothamBold
        rb.TextSize = 9
        rb.Parent = Card
        addCorner(rb, 4)
    elseif recomendado then
        local rb = Instance.new("TextLabel")
        rb.Size = UDim2.new(0, 100, 0, 20)
        rb.Position = UDim2.new(1, badgeX - 5, 0.5, -10)
        rb.BackgroundColor3 = C.Yellow
        rb.Text = "RECOMMENDED"
        rb.TextColor3 = Color3.fromRGB(20, 20, 20)
        rb.Font = Enum.Font.GothamBold
        rb.TextSize = 9
        rb.Parent = Card
        addCorner(rb, 4)
    end

    local kb = Instance.new("TextLabel")
    kb.Size = UDim2.new(0, 62, 0, 20)
    kb.Position = UDim2.new(1, -120, 0.5, -10)
    if keyCustom then
        kb.BackgroundColor3 = C.Pink
        kb.Text = "🔒 PRIVATE"
        kb.Size = UDim2.new(0, 78, 0, 20)
        kb.Position = UDim2.new(1, -136, 0.5, -10)
    else
        kb.BackgroundColor3 = noKey and C.Green or C.Red
        kb.Text = noKey and "No Key" or "Key"
    end
    kb.TextColor3 = Color3.fromRGB(255, 255, 255)
    kb.Font = Enum.Font.GothamBold
    kb.TextSize = 10
    kb.Parent = Card
    addCorner(kb, 4)

    local Run = Instance.new("TextButton")
    Run.Size = UDim2.new(0, 50, 0, 26)
    Run.Position = UDim2.new(1, -55, 0.5, -13)
    Run.BackgroundColor3 = C.Purple
    Run.Text = "run"
    Run.TextColor3 = Color3.fromRGB(255, 255, 255)
    Run.Font = Enum.Font.GothamBold
    Run.TextSize = 11
    Run.AutoButtonColor = false
    Run.Parent = Card
    addCorner(Run, 5)

    Card.MouseEnter:Connect(function()
        TweenService:Create(Card, TweenInfo.new(0.15), {BackgroundColor3 = C.CardHover}):Play()
    end)
    Card.MouseLeave:Connect(function()
        TweenService:Create(Card, TweenInfo.new(0.15), {BackgroundColor3 = C.Card}):Play()
    end)
    Run.MouseEnter:Connect(function()
        TweenService:Create(Run, TweenInfo.new(0.15), {BackgroundColor3 = C.PurpleHover}):Play()
    end)
    Run.MouseLeave:Connect(function()
        TweenService:Create(Run, TweenInfo.new(0.15), {BackgroundColor3 = C.Purple}):Play()
    end)

    Run.MouseButton1Click:Connect(function()
        if keyCustom then
            PopupKey(nome, keyCustom, C.Pink)
            if url == "COLE_A_URL_AQUI" or url == "" then
                return
            end
            task.wait(0.3)
        elseif not noKey then
            Notify("🔑 " .. nome .. " precisa de KEY!", C.Yellow)
            task.wait(0.4)
        end

        Notify("⏳ Carregando " .. nome .. "...", C.Purple)

        task.spawn(function()
            local ok, err = pcall(function()
                loadstring(game:HttpGet(url))()
            end)
            if ok then
                Notify("✅ " .. nome .. " carregado!", C.Green)
            else
                Notify("❌ Erro: " .. tostring(err):sub(1, 40), C.Red)
            end
        end)
    end)

    table.insert(cards, {frame = Card, nome = nome, noKey = noKey, recomendado = recomendado})
end

