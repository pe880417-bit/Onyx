    l.Font = Enum.Font.GothamMedium
    l.TextSize = 12
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = b

    if badge then
        local bg = Instance.new("TextLabel")
        bg.Size = UDim2.new(0, 18, 0, 18)
        bg.Position = UDim2.new(1, -22, 0.5, -9)
        bg.BackgroundColor3 = C.Red
        bg.Text = tostring(badge)
        bg.TextColor3 = Color3.fromRGB(255, 255, 255)
        bg.Font = Enum.Font.GothamBold
        bg.TextSize = 10
        bg.Parent = b
        addCorner(bg, 9)
    end

    if not ativo then
        b.MouseEnter:Connect(function()
            TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(42, 32, 58)}):Play()
        end)
        b.MouseLeave:Connect(function()
            TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(30, 24, 42)}):Play()
        end)
    end
    return b
end

