-- Notify
local function Notify(texto, cor, duracao)
    duracao = duracao or 2.5
    cor = cor or C.Green
    local n = Instance.new("TextLabel")
    n.Size = UDim2.new(0, 320, 0, 38)
    n.Position = UDim2.new(0.5, -160, 1, -30)
    n.BackgroundColor3 = C.TopBar
    n.TextColor3 = cor
    n.Font = Enum.Font.GothamBold
    n.TextSize = 12
    n.Text = texto
    n.TextTransparency = 1
    n.BackgroundTransparency = 1
    n.Parent = ScreenGui
    addCorner(n, 8)
    local s = addStroke(n, cor, 1.5, 1)

    TweenService:Create(n, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, -160, 1, -60),
        BackgroundTransparency = 0,
        TextTransparency = 0
    }):Play()
    TweenService:Create(s, TweenInfo.new(0.3), {Transparency = 0}):Play()

    task.delay(duracao, function()
        TweenService:Create(n, TweenInfo.new(0.25), {
            Position = UDim2.new(0.5, -160, 1, -40),
            BackgroundTransparency = 1,
            TextTransparency = 1
        }):Play()
        TweenService:Create(s, TweenInfo.new(0.25), {Transparency = 1}):Play()
        task.wait(0.3)
        n:Destroy()
    end)
end

